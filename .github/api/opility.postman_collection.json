{
  "info": {
    "name": "Opility public API audit",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://opility.com"
    }
  ],
  "item": [
    {
      "name": "Public account configuration",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/account-config"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "pm.test('Public config, no privileged key',()=>{const b=pm.response.json();pm.expect(b.enabled).to.be.a('boolean');pm.expect(pm.response.text()).not.to.include('service_role');console.log('ACCOUNT_ENABLED',b.enabled);});"
            ]
          }
        }
      ]
    },
    {
      "name": "Studio catalog",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/studio-catalog"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "pm.test('Catalog shape',()=>{const b=pm.response.json();pm.expect(b.assets).to.be.an('array');console.log('CATALOG_COUNT',b.count);});"
            ]
          }
        }
      ]
    },
    {
      "name": "Anonymous entitlements",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/account/entitlements"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 401',()=>pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "Unknown product download",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/download?product=not-a-product"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 404',()=>pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    },
    {
      "name": "Anonymous verification denied",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/verify-purchase",
        "body": {
          "mode": "raw",
          "raw": "{}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 401',()=>pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "Private download not public",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/downloads/unknown.pdf"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 404',()=>pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    },
    {
      "name": "Removed admin",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/admin"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 410',()=>pm.response.to.have.status(410));"
            ]
          }
        }
      ]
    },
    {
      "name": "Chat health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/opility-chat"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "console.log('CHAT_HEALTH',JSON.stringify(pm.response.json()));"
            ]
          }
        }
      ]
    },
    {
      "name": "Invalid chat",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Origin",
            "value": "https://opility.com"
          }
        ],
        "url": "{{baseUrl}}/api/opility-chat",
        "body": {
          "mode": "raw",
          "raw": "{\"messages\":[]}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 400',()=>pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "Missing Turnstile token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Origin",
            "value": "https://opility.com"
          }
        ],
        "url": "{{baseUrl}}/api/verify-turnstile",
        "body": {
          "mode": "raw",
          "raw": "{}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 400',()=>pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "Business chat response",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Origin",
            "value": "https://opility.com"
          }
        ],
        "url": "{{baseUrl}}/api/opility-chat",
        "body": {
          "mode": "raw",
          "raw": "{\"messages\":[{\"role\":\"user\",\"content\":\"What services does Opility QA offer? Answer briefly.\"}]}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "pm.test('Business reply',()=>{const b=pm.response.json();pm.expect(b.reply).to.be.a('string').and.not.empty;console.log('CHAT_MODE',b.mode,b.ai_status||'');});"
            ]
          }
        }
      ]
    }
  ]
}