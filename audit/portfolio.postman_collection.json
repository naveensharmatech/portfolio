    {
      "name": "Public profile answer",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/chat",
        "body": {
          "mode": "raw",
          "raw": "{\"messages\":[{\"role\":\"user\",\"content\":\"Who is Naveen Sharma? Give his professional title briefly.\"}]}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Question has a usable reply',()=>{pm.response.to.have.status(200);const b=pm.response.json();pm.expect(b.reply).to.be.a('string').and.not.empty;pm.expect(['ai','saved-knowledge']).to.include(b.mode);});",
              "pm.test('Configured AI is actually responding',()=>{const b=pm.response.json();if(pm.environment.get('aiConfigured')===true)pm.expect(b.mode,JSON.stringify({mode:b.mode,ai_status:b.ai_status})).to.equal('ai');});"
            ]
          }
        }
      ]
    },
