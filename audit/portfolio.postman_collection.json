{
  "info": {
    "name": "Portfolio Ella API Audit",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Bounded public API contract checks. Three harmless model questions per target; malformed inputs must be rejected before contacting the provider. No load testing."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://naveensharma.net"
    }
  ],
  "item": [
    {
      "name": "Health and configuration",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/chat"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Health returns JSON',()=>{pm.response.to.have.status(200);const b=pm.response.json();pm.expect(b.status).to.equal('Ella is live');pm.expect(b.ai_configured).to.be.a('boolean');pm.expect(b.knowledge_updated).to.be.a('string');pm.environment.set('aiConfigured',b.ai_configured);});",
              "pm.test('Health is not cached',()=>pm.expect(pm.response.headers.get('Cache-Control')).to.include('no-store'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Malformed JSON",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/chat",
        "body": {
          "mode": "raw",
          "raw": "{"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Reject invalid request with 400',()=>pm.response.to.have.status(400));",
              "pm.test('JSON error with no-store',()=>{pm.expect(pm.response.json().error).to.be.a('string');pm.expect(pm.response.headers.get('Cache-Control')).to.include('no-store');});"
            ]
          }
        }
      ]
    },
    {
      "name": "No messages",
      "request": {
